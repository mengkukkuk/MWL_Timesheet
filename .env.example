# ── Team Worklog — Server Configuration ──────────────────────────────────────

# Flask session signing key (change this to a random string!)
SECRET_KEY=Metercenter
# PORT is read by app.py; APP_PORT by install-service.bat and dev.bat. Keep equal.
PORT=5050
APP_PORT=5050
FLASK_DEBUG=false

# ── SQL Server Connection ─────────────────────────────────────────────────────
# If SQL Server is on this same machine, keep host.docker.internal to redirect to the host from Docker containers
# If SQL Server is on another machine on the LAN, use its IP (e.g. 192.168.1.50,1433)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=MeterWorklog
DB_DRIVER={ODBC Driver 17 for SQL Server}
DB_TRUST_CERT=yes
# SA auth for deployment, DB_TRUST_CERT=no
# DB_SERVER=192.168.73.67
# DB_USER=sa
# DB_PASSWORD=P@ssw0rd

# ── Cloudflare Tunnel (token-based, remotely-managed) ────────────────────────
# Create the tunnel + public hostname route in the Cloudflare Zero Trust
# dashboard (Networks → Tunnels), then paste the connector token here.
CF_TUNNEL_TOKEN=
# Public hostname routed to this app, e.g. mwl.yourdomain.com
CF_TUNNEL_DOMAIN=

# ── Cloudflare Worker edge (wrangler) ────────────────────────────────────────
# The Worker serves the static SPA and proxies /api/* to this Flask app, so the
# browser's Origin is the Worker's hostname, not CF_TUNNEL_DOMAIN. Set this so
# the CSRF origin check trusts it:
#   staging   mwl-timesheet.<account>.workers.dev
#   custom    mwl.yourdomain.com   (same value as CF_TUNNEL_DOMAIN — fine)
# The Worker also sends X-Forwarded-Host/-Proto, which the CSRF check already
# trusts, so a blank value still works. Set it anyway as belt-and-braces.
WORKER_DOMAIN=

# ── ngrok Tunnel (DEPRECATED — replaced by Cloudflare Tunnel above; kept
#    temporarily as a rollback path. Safe to blank/delete once Cloudflare
#    Tunnel is confirmed stable) ───────────────────────────────────────────
# Get these from https://dashboard.ngrok.com after signing up (free)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

#Tailscale config
#TAILSCALE_DOMAIN=
#SESSION_COOKIE_SECURE=false

#GB (value is in megabytes)
FILE_STORAGE_CAP_MB=10240
FILE_MIN_FREE_MB=8192
WAITRESS_CHANNEL_TIMEOUT=3600

# Per-file upload cap. Capped at 100 MB because requests reach Flask through the
# Cloudflare Worker, and Cloudflare's proxied request-body limit is 100 MB on
# Free/Pro (200 MB Business, 500 MB Enterprise). Raising this alone does NOT
# raise the real limit — anything larger dies at the edge with a 413 that Flask
# never sees. The SPA reads the effective value from /api/files/stats and
# rejects oversized files client-side before uploading.
FILE_UPLOAD_MAX_MB=100
# Must be >= FILE_UPLOAD_MAX_MB * 1024 * 1024 (Waitress rejects before Flask).
WAITRESS_MAX_REQUEST_BODY=104857600

#AVATAR profile
#AVATAR_STORAGE_DIR=

# ── Email (password reset) — Brevo ────────────────────────────────────────────
# Preferred: HTTPS API (BREVO_API_KEY). Fallback: SMTP STARTTLS smtp-relay.brevo.com:587.
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURITY=starttls
# Public base URL used to build reset links, e.g. https://your-domain.example
# Auto-derived from CF_TUNNEL_DOMAIN (or NGROK_DOMAIN as a fallback) by
# install-service.bat if left blank here.
APP_BASE_URL=
# Optional tuning (defaults shown)
#RESET_TOKEN_TTL_MINUTES=60
#RESET_EMAIL_COOLDOWN_SECONDS=300
