# ── Team Worklog — Server Configuration ──────────────────────────────────────

# Flask session signing key (change this to a random string!)
SECRET_KEY=Metercenter
PORT=5050
FLASK_DEBUG=false

# ── Database Engine Selection ─────────────────────────────────────────────────
# mssql    → SQL Server via pyodbc   (DB_* vars below)
# postgres → PostgreSQL via psycopg2 (PG_* vars below)
DB_ENGINE=mssql
# Set to 1 to make a failed schema init raise instead of only logging (dev/CI).
DB_INIT_STRICT=

# ── SQL Server Connection (DB_ENGINE=mssql) ───────────────────────────────────
# If SQL Server is on this same machine, keep host.docker.internal to redirect to the host from Docker containers
# If SQL Server is on another machine on the LAN, use its IP (e.g. 192.168.1.50,1433)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=MeterWorklog
DB_DRIVER={ODBC Driver 17 for SQL Server}
DB_TRUST_CERT=yes
# SA auth for deployment, DB_TRUST_CERT=no
# DB_SERVER=192.168.73.67
# DB_USER=sa
# DB_PASSWORD=P@ssw0rd

# ── PostgreSQL Connection (DB_ENGINE=postgres) ────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=mwl
PG_SCHEMA=mwlts
PG_USER=postgres
PG_PASSWORD=
# Session time zone for the PG connection. Postgres CURRENT_TIMESTAMP is
# timestamptz; pinning this keeps reviewed_at/UpdateAt aligned with MSSQL's
# local-time GETDATE().
PG_TIMEZONE=Asia/Bangkok
# Windows only. Needed when psycopg2 was built from source (no wheel for this
# Python version) and therefore links against the local PostgreSQL libpq.dll,
# which Windows will not find via PATH. Leave blank if `import psycopg2` works.
PG_BIN_DIR=

# ── ngrok Tunnel (optional — remove if not needed) ───────────────────────────
# Get these from https://dashboard.ngrok.com after signing up (free)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

#Tailscale config
#TAILSCALE_DOMAIN=
#SESSION_COOKIE_SECURE=false

#GB (value is in megabytes) 
FILE_STORAGE_CAP_MB=10240
FILE_UPLOAD_MAX_MB=5120
FILE_MIN_FREE_MB=8192
WAITRESS_CHANNEL_TIMEOUT=3600
WAITRESS_MAX_REQUEST_BODY=5368709120

#AVATAR profile
#AVATAR_STORAGE_DIR=

# ── Email (password reset) — Brevo ────────────────────────────────────────────
# Preferred: HTTPS API (BREVO_API_KEY). Fallback: SMTP STARTTLS smtp-relay.brevo.com:587.
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURITY=starttls
# Public base URL used to build reset links, e.g. https://your-domain.example
APP_BASE_URL=
# Optional tuning (defaults shown)
#RESET_TOKEN_TTL_MINUTES=60
#RESET_EMAIL_COOLDOWN_SECONDS=300
