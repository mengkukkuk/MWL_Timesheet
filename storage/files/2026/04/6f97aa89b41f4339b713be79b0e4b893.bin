├── static/
│   ├── app.js               # Frontend module loader (no build step)
│   ├── style.css            # Custom styles
│   └── app/                 # Per-feature frontend modules
│       ├── i18n.js          # EN/TH translations + data-i18n wiring
│       ├── core.js          # Tabs, currentUser, api(), toast(), esc()
│       ├── dashboard.js     # Dashboard view
