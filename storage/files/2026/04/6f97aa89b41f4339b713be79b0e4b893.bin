├── .env                     # DB credentials, SECRET_KEY, ngrok, storage caps
├── app/                     # Flask blueprints (one per feature)
│   ├── __init__.py          # App factory, config, CSRF-origin check, blueprint registration
│   ├── constants.py         # Role constants
│   ├── helpers.py           # parse_time, format_members, parse_members
│   ├── auth.py              # Login / register / logout
│   ├── core.py              # /, /api/me, /api/dashboard
│   ├── members.py           # Members CRUD
